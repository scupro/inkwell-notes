# Neon 連接字串（Neon 控制台 → Connection string，保留 ?sslmode=require）
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# 訪問密碼
APP_PASSWORD=change-me
# 用於簽名登入令牌的隨機長字串（可用 openssl rand -hex 32 生成）
AUTH_SECRET=please-generate-a-long-random-string
# 登入有效天數（可選，默認 30）
SESSION_DAYS=30
